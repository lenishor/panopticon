<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.panopticon</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/leni/Projects/panopticon/panopticon.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>ExitTimeOut</key>
  <integer>10</integer>

  <key>ProcessType</key>
  <string>Interactive</string>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/leni/.panopticon/panopticon.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/leni/.panopticon/panopticon.err</string>
</dict>
</plist>
